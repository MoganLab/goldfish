;; +
;; 计算多个数值之和（溢出自动提升为大整数）。
;;
;; 语法
;; ----
;; (+ z ...)
;;
;; 参数
;; ----
;; z : number? 数值。
;;
;; 返回值
;; ----
;; number? 和。

(import (liii check) (liii bignum))

(check-set-mode! 'report-failed)

(check (+ 9223372036854775807 1) => 9223372036854775808)
(check (+ 100000000000000000000 1/2) => 200000000000000000001/2)
(check (+ 100000000000000000000 1+2i) => 100000000000000000001+2i)
(check (+) => 0)

(check-report)
