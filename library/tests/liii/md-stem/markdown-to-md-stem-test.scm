;; markdown->md-stem
;; 把 Markdown 文本转换成 md-stem S 表达式。
;;
;; 语法
;; ----
;; (markdown->md-stem markdown)
;;
;; 返回值
;; ----
;; pair
;; 返回形如 (md-stem ...) 的 S 表达式。
;; 当前测试覆盖段落、标题、代码块与行内代码等语义节点。

(define (read-file-string path)
  (call-with-input-file path
    (lambda (port)
      (let loop
        ((chars '()))
        (let ((ch (read-char port)))
          (if (eof-object? ch) (list->string (reverse chars)) (loop (cons ch chars)))
        ) ;let
      ) ;let
    ) ;lambda
  ) ;call-with-input-file
) ;define

(define (resource-path basename extension)
  (string-append "tests/resources/markdown/" basename extension)
) ;define

(define (expected-md-stem basename)
  (call-with-input-file (resource-path basename ".md.stem")
    (lambda (port) (read-md-stem port))
  ) ;call-with-input-file
) ;define

(define (check-resource-case basename)
  (let ((markdown (read-file-string (resource-path basename ".md"))))
    (check (markdown->md-stem markdown) => (expected-md-stem basename))
  ) ;let
) ;define

(define nbsp-string (string-append "" (string (integer->char 160)) ""))


