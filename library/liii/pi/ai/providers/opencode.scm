    ;; Provider 配置：api 为协议实现标识（OpenAI Chat Completions 兼容），
    ;; baseUrl 为 OpenCode Go 官方订阅端点，
    ;; envKeys 为依次尝试的 API key 环境变量（OPENCODE_API_KEY / OPENCODE_GO_API_KEY）
    (define PI_OPENCODE_PROVIDER
      '((api . "openai-completions")
        (baseUrl . "https://opencode.ai/zen/go/v1")
        (envKeys "OPENCODE_API_KEY" "OPENCODE_GO_API_KEY"))
    ) ;define

    ;; 「额度耗尽」识别：OpenCode Go 订阅
    ;;
    ;;   HTTP 403/429 且错误标识（name / type / code）为 GoUsageLimitError、
    ;;   go-limit 或 FreeUsageLimitError：
    ;;   {"type":"error","error":{"type":"go-limit",
    ;;    "message":"Usage limit reached. It will reset in ...",
    ;;    "metadata":{"limitName":"5-hour"}}}
    ;;
    ;; 返回值：((kind . quota) (code . ...) (message . ...)) 或 #f
    (define (PI_OPENCODE_QUOTA_ERROR status-code body-str)
      (pi-quota-error-result status-code
        body-str
        '(("GoUsageLimitError" . "quota")
          ("go-limit" . "quota")
          ("FreeUsageLimitError" . "quota"))
      ) ;pi-quota-error-result
    ) ;define

