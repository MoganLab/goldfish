(table
  (align default default)
  (thead
    (tr (th "Type") (th "Value")))
  (tbody
    (tr (td "link") (td (link "https://example.com" "" "site")))
    (tr (td "image") (td (image "logo.png" "Logo" "logo")))
    (tr (td "auto") (td (link "https://example.com/docs" "" "https://example.com/docs")))))
