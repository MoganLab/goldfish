// X-macro table for gf forwarding shims.
// Single source for count/version auditing (LAYER.md L0).
// Each line: GF_FWD(ret, name, args, call)

GF_FWD(scheme*, init, (), s7_init())
GF_FWD(pointer, f, (scheme* sc), s7_f(sc))
