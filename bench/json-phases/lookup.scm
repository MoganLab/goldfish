(import (liii json) (scheme base) (scheme time))

(define (build-object-json count)
  (let ((out (open-output-string)))
    (display "{" out)
    (do ((i 0 (+ i 1)))
      ((= i count))
      (when (> i 0) (display "," out))
      (display "\"k" out)
      (display i out)
      (display "\":" out)
      (display i out))
    (display "}" out)
    (get-output-string out)))

(define object-json (build-object-json 200))
(define object-value (string->json object-json))
(define target-key "k150")
(define (require-result condition message)
  (unless condition (error "JSON benchmark result check failed" message)))
(define (time-phase label count thunk)
  (display "PHASE-BEGIN\t") (display label) (newline)
  (flush-output-port (current-output-port))
  (let ((start (monotonic-nanosecond)))
    (do ((i 0 (+ i 1))) ((= i count)) (thunk))
    (let ((elapsed (- (monotonic-nanosecond) start)))
      (display "PHASE\t") (display label) (display "\t") (display elapsed) (newline)
      (flush-output-port (current-output-port))
      (display "JSON-PHASE ") (display label)
      (display " count=") (display count)
      (display " ns=") (display elapsed) (newline) elapsed)))
(define (warm-up thunk)
  (do ((i 0 (+ i 1))) ((= i 10)) (thunk)))

(warm-up (lambda () (json-ref object-value target-key)))
(time-phase "lookup" 20000 (lambda () (json-ref object-value target-key)))
(require-result (= (json-ref object-value target-key) 150) "target key value")
(require-result (null? (json-ref object-value "missing")) "missing key")
(display "JSON-PHASE-OK lookup\n")
