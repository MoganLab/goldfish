(import (liii check) (liii pi) (liii pi minimax))

(check-set-mode! 'report-failed)

;; minimax-parse-response
;; 解析 MiniMax / Anthropic 兼容网关返回的完整响应 JSON 对象。
(let* ((resp '(("id" . "msg_123")
               ("type" . "message")
               ("role" . "assistant")
               ("content" . (((type . "thinking")
                              (thinking . "thinking...")
                              (signature . "sig-abc"))
                             ((type . "text") (text . "MiniMax Pong"))
                             ((type . "tool_use")
                              (id . "call_1")
                              (name . "read")
                              (input . (("path" . "a.txt"))))))
               ("stop_reason" . "tool_use")
               ("usage" . (("input_tokens" . 10) ("output_tokens" . 5)))))
       (parsed (minimax-parse-response resp)))
  (check (pi-assistant-message? parsed) => #t)
  (check (pi-assistant-message-role parsed) => "assistant")
  (check (pi-assistant-message-stop-reason parsed) => "toolUse")
  (let* ((content (pi-assistant-message-content parsed))
         (text-blk (list-ref content 1))
         (tool-blk (list-ref content 2)))
    (check (pi-text-block-text text-blk) => "MiniMax Pong")
    (check (pi-tool-call-block-id tool-blk) => "call_1")
    (check (pi-tool-call-block-name tool-blk) => "read")
    (check (pi-tool-call-block-arguments tool-blk) => '(("path" . "a.txt"))))
  (let ((u (pi-assistant-message-usage parsed)))
    (check (cdr (assoc 'input u)) => 10)
    (check (cdr (assoc 'output u)) => 5)))

(check-report)
