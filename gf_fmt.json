{
  "cpp": {
    "suffix": ["hpp", "cpp", "h", "c", "cc", "cxx"],
    "path": ["src"],
    "binary-linux": ["/usr/bin/clang-format-19", "/usr/bin/clang-format"],
    "binary-macos": ["/opt/homebrew/opt/llvm@19/bin/clang-format", "/usr/local/opt/llvm@19/bin/clang-format"],
    "exclude": [
      "tests",
      "3rdparty"
    ]
  },
  "scheme": {
    "suffix": ["scm"],
    "path": ["goldfish", "tools"],
    "exclude": [
      "tests"
    ]
  }
}
