{
  "goldfish_version": "18.11",
  "rules": {
    "max-file-lines": {
      "enabled": true,
      "limit": 400
    },
    "max-tree-depth": {
      "enabled": true,
      "limit": 15
    },
    "define-record-type": {
      "enabled": true
    },
    "no-glue": {
      "enabled": true
    },
    "type-hint": {
      "enabled": true
    },
    "unit-test": {
      "enabled": false
    },
    "no-crlf": {
      "enabled": true,
      "suffix": [
        "scm",
        "json",
        "c",
        "cpp",
        "h",
        "hpp",
        "cc",
        "cxx"
      ],
      "path": [
        "goldfish",
        "library",
        "tests",
        "tools",
        "demo",
        "src",
        "xmake"
      ]
    },
    "layer-order": {
      "file": "gf_check_layer_order.json"
    }
  },
  "excludes": {
    "layer-order": [
      {
        "path": "tools/check/tests/resources/",
        "reason": "type-hint 规则测试 fixture 使用虚构库名"
      }
    ],
    "unit-test": [
      {
        "path": "library/tests/liii/date-time/date-time-test.scm",
        "reason": "(liii date-time) 总聚合入口测试，跨全部子库验证导出接口协同，不适用单函数文档规范"
      },
      {
        "path": "tests/scheme/",
        "reason": "现有语言测试正向 goldfish/tests/ 迁移，迁移前保留旧测试布局与文档规范"
      },
      {
        "path": "tests/srfi/srfi-113/",
        "reason": "SRFI-113 测试尚未完全从 liii/set 与 liii/bag 合并迁移"
      },
      {
        "path": "tools/pi/liii/pi/code/core/tools",
        "reason": "工具核心库聚合重导出尚未完全拆分为单函数测试目录"
      },
      {
        "path": "tools/pi/tests/liii/pi/code/core/tools",
        "reason": "工具核心库聚合测试用例尚未完全拆分为单函数测试目录"
      },
      {
