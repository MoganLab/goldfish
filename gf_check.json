{
  "goldfish_version": "18.11",
  "rules": {
    "max-file-lines": {
      "enabled": true,
      "limit": 400
    },
    "max-tree-depth": {
      "enabled": true,
      "limit": 15
    },
    "define-record-type": {
      "enabled": true
    },
    "no-glue": {
      "enabled": true
    },
    "no-crlf": {
      "enabled": true,
      "suffix": [
        "scm",
        "json",
        "c",
        "cpp",
        "h",
        "hpp",
        "cc",
        "cxx"
      ],
      "path": [
        "goldfish",
        "tests",
        "tools",
        "demo",
        "src",
        "xmake"
      ]
    },
    "layer-order": {
      "file": "gf_check_layer_order.json"
    }
  },
  "excludes": {
    "no-glue": [
      "bench/filter.scm",
      "bench/take-right-drop-right.scm",
      "bench/take.scm",
      "goldfish/liii/date-time/internal/database-discover.scm",
