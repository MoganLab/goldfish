{
  "goldfish_version": "18.11",
  "rules": {
    "max-file-lines": {
      "enabled": true,
      "limit": 400
    },
    "max-tree-depth": {
      "enabled": true,
      "limit": 15
    },
    "define-record-type": {
      "enabled": true
    },
    "no-glue": {
      "enabled": true
    },
    "type-hint": {
      "enabled": true
    },
    "unit-test": {
      "enabled": true
    },
    "no-crlf": {
      "enabled": true,
      "suffix": [
        "scm",
        "json",
        "c",
        "cpp",
        "h",
        "hpp",
        "cc",
        "cxx"
      ],
      "path": [
        "goldfish",
        "r7rs",
        "library",
        "tools",
        "demo",
        "src",
        "xmake"
      ]
    },
    "layer-order": {
      "file": "gf_check_layer_order.json"
    }
  },
  "excludes": {
    "layer-order": [
      {
        "path": "tools/check/tests/resources/",
        "reason": "type-hint 规则测试 fixture 使用虚构库名"
      }
    ],
    "unit-test": [],
    "no-glue": [
      "bench/",
      "r7rs/scheme/boot.scm",
      "goldfish/srfi/srfi-13.scm",
      "tests/"
    ],
    "max-file-lines": [
