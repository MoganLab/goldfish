(import (scheme base) (liii check))
(check-set-mode! 'report-failed)

;; Finite exact numbers stay finite when compared with infinities.
(let ((huge (expt 10 400)))
  (check (= huge +inf.0) => #f)
  (check (= +inf.0 huge) => #f)
  (check (= (- huge) -inf.0) => #f)
  (check (= -inf.0 (- huge)) => #f)
  (check (< -inf.0 (- huge) huge +inf.0) => #t)
  (check (> +inf.0 huge (- huge) -inf.0) => #t)
  (check (<= huge +inf.0) => #t)
  (check (>= huge +inf.0) => #f)
  (check (<= -inf.0 (- huge)) => #t)
  (check (>= -inf.0 (- huge)) => #f)
  (check (> huge 1.7976931348623157e308) => #t)
  (check (< 1.7976931348623157e308 huge) => #t)
  (check (< (/ 1 huge) (inexact (/ 1 (expt 2 1074)))) => #t)
  (check (> (/ 1 huge) 0.0) => #t)
  (check (< (- (/ 1 huge)) -0.0) => #t))

;; Mixed finite comparisons retain precision beyond the float significand.
(check (= 9007199254740993 9007199254740992.0) => #f)
(check (> 9007199254740993 9007199254740992.0) => #t)
(check (< 9007199254740992.0 9007199254740993) => #t)
(check (< 1/10 0.1) => #t)
(check (= 1/2 0.5) => #t)
(check (= 0 -0.0) => #t)
(check (= +inf.0 +inf.0) => #t)
(check (= -inf.0 -inf.0) => #t)
(check (< -inf.0 +inf.0) => #t)
(check (> +inf.0 -inf.0) => #t)
(check (= +nan.0 +nan.0) => #f)
(check (< +nan.0 0) => #f)
(check (<= 0 +nan.0) => #f)
(check (> +nan.0 +inf.0) => #f)
(check (>= -inf.0 +nan.0) => #f)
(check-report)
