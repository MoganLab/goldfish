(import (liii check) (liii semver))

(check-set-mode! 'report-failed)

;; semver>?
;; 判断版本 s1 是否严格大于版本 s2（SemVer 2.0.0 优先级）。
;;
;; 语法
;; ----
;; (semver>? s1 s2)
;;
;; 参数
;; ----
;; s1 : string
;; 左侧版本字符串。
;;
;; s2 : string
;; 右侧版本字符串。
;;
;; 返回值
;; ----
;; boolean 或 #f
;; s1 > s2 返回 #t，否则返回 #f；任一版本非法时返回 #f。
;; 预发布版本低于同核心段的正式版；构建元数据不参与比较。
;;
;; 错误处理
;; ----
;; 任一版本非法时不抛错，返回 #f。
;;
;; 示例
;; ----
;; (semver>? "2026.3.5" "2026.3.2-rc.1") => #t
;; (semver>? "2026.3.2-rc.10" "2026.3.2-rc.2") => #t

;; 经典用户场景：2026.3.2-rc.1 vs 2026.3.5
(check (semver>? "2026.3.2-rc.1" "2026.3.5") => #f)
(check (semver>? "2026.3.5" "2026.3.2-rc.1") => #t)
;; 核心段比较
(check (semver>? "2.1.1" "2.1.0") => #t)
(check (semver>? "1.0.0" "1.0.0") => #f)
;; 预发布纯数字标识符按数值大小比较（防止 rc.10 与 rc.2 倒挂）
(check (semver>? "2026.3.2-rc.10" "2026.3.2-rc.2") => #t)
;; 预发布段：数值 vs 非数值
(check (semver>? "1.0.0-rc.1.a" "1.0.0-rc.1.1") => #t)
;; 非法版本返回 #f
(check (semver>? "1.0.0" "invalid") => #f)

(check-report)
