(import (liii check) (liii tui keys))

(check-set-mode! 'report-failed)

;; 基础 ASCII 字符与空格
(check (parse-key "a") => "a")
(check (parse-key "Z") => "Z")
(check (parse-key "0") => "0")
(check (parse-key " ") => " ")
(check (parse-key "#") => "#")
(check (parse-key "=") => "=")

;; UTF-8 多字节字符
(check (parse-key "你") => "你")
(check (parse-key "好") => "好")
(check (parse-key "λ") => "λ")
(check (parse-key "🎉") => "🎉")

;; 基础控制字符与回车退格
(check (parse-key "\r") => 'enter)
(check (parse-key "\n") => 'ctrl-j)
(check (parse-key "\r\n") => 'enter)
(check (parse-key "\t") => 'tab)
(check (parse-key "\b") => 'backspace)
(check (parse-key "") => 'backspace)
(check (parse-key "\x1b;") => 'escape)

;; Ctrl 组合键 (ASCII 0..26, 28..31)
(check (parse-key "\x00;") => 'ctrl-space)
(check (parse-key "\x01;") => 'ctrl-a)
(check (parse-key "\x02;") => 'ctrl-b)
(check (parse-key "\x03;") => 'ctrl-c)
(check (parse-key "\x04;") => 'ctrl-d)
(check (parse-key "\x05;") => 'ctrl-e)
(check (parse-key "\x06;") => 'ctrl-f)
(check (parse-key "\x07;") => 'ctrl-g)
(check (parse-key "\x0b;") => 'ctrl-k)
(check (parse-key "\f") => 'ctrl-l)
(check (parse-key "\x0e;") => 'ctrl-n)
(check (parse-key "\x0f;") => 'ctrl-o)
(check (parse-key "\x10;") => 'ctrl-p)
(check (parse-key "\x11;") => 'ctrl-q)
(check (parse-key "\x12;") => 'ctrl-r)
(check (parse-key "\x13;") => 'ctrl-s)
(check (parse-key "\x14;") => 'ctrl-t)
(check (parse-key "\x15;") => 'ctrl-u)
(check (parse-key "\x16;") => 'ctrl-v)
(check (parse-key "\x17;") => 'ctrl-w)
(check (parse-key "\x18;") => 'ctrl-x)
(check (parse-key "\x19;") => 'ctrl-y)
(check (parse-key "\x1a;") => 'ctrl-z)
(check (parse-key "\x1c;") => 'ctrl-\)
(check (parse-key "\x1d;") => 'ctrl-])
(check (parse-key "\x1e;") => 'ctrl-^)
(check (parse-key "\x1f;") => 'ctrl-_)

;; 方向键 (ANSI 与 SS3)
(check (parse-key "\x1b;[A") => 'up)
(check (parse-key "\x1b;[B") => 'down)
(check (parse-key "\x1b;[C") => 'right)
(check (parse-key "\x1b;[D") => 'left)

(check (parse-key "\x1b;OA") => 'up)
(check (parse-key "\x1b;OB") => 'down)
(check (parse-key "\x1b;OC") => 'right)
(check (parse-key "\x1b;OD") => 'left)

;; 导航与编辑键
(check (parse-key "\x1b;[H") => 'home)
(check (parse-key "\x1b;[F") => 'end)
(check (parse-key "\x1b;[1~") => 'home)
(check (parse-key "\x1b;[4~") => 'end)
(check (parse-key "\x1b;[7~") => 'home)
(check (parse-key "\x1b;[8~") => 'end)
(check (parse-key "\x1b;OH") => 'home)
(check (parse-key "\x1b;OF") => 'end)
(check (parse-key "\x1b;[2~") => 'insert)
(check (parse-key "\x1b;[3~") => 'delete)
(check (parse-key "\x1b;[5~") => 'page-up)
(check (parse-key "\x1b;[6~") => 'page-down)
(check (parse-key "\x1b;[E") => 'clear)

;; 功能键 F1 ~ F12
(check (parse-key "\x1b;OP") => 'f1)
(check (parse-key "\x1b;OQ") => 'f2)
(check (parse-key "\x1b;OR") => 'f3)
(check (parse-key "\x1b;OS") => 'f4)
(check (parse-key "\x1b;[[A") => 'f1)
(check (parse-key "\x1b;[[B") => 'f2)
(check (parse-key "\x1b;[[C") => 'f3)
(check (parse-key "\x1b;[[D") => 'f4)
(check (parse-key "\x1b;[[E") => 'f5)
(check (parse-key "\x1b;[11~") => 'f1)
(check (parse-key "\x1b;[12~") => 'f2)
(check (parse-key "\x1b;[13~") => 'f3)
(check (parse-key "\x1b;[14~") => 'f4)
(check (parse-key "\x1b;[15~") => 'f5)
(check (parse-key "\x1b;[17~") => 'f6)
(check (parse-key "\x1b;[18~") => 'f7)
(check (parse-key "\x1b;[19~") => 'f8)
(check (parse-key "\x1b;[20~") => 'f9)
(check (parse-key "\x1b;[21~") => 'f10)
(check (parse-key "\x1b;[23~") => 'f11)
(check (parse-key "\x1b;[24~") => 'f12)

;; 修饰键组合 (Shift / Alt / Ctrl + 导航或功能键)
(check (parse-key "\x1b;[Z") => 'shift-tab)
(check (parse-key "\x1b;[1;2Z") => 'shift-tab)
(check (parse-key "\x1b;[9;2u") => 'shift-tab)
(check (parse-key "\x1b;[13;2u") => 'shift-enter)
(check (parse-key "\x1b;[13;5u") => 'ctrl-enter)
(check (parse-key "\x1b;[13;3u") => 'alt-enter)
(check (parse-key "\x1b;[13;2:1u") => 'shift-enter)
(check (parse-key "\x1b;[57414;2u") => 'shift-enter)
(check (parse-key "\x1b;[57414;5u") => 'ctrl-enter)
(check (parse-key "\x1b;[57414;3u") => 'alt-enter)
(check (parse-key "\x1b;[57414u") => 'enter)
(check (parse-key "\x1b;OM") => 'shift-enter)
(check (parse-key "\x1b;[13;2~") => 'shift-enter)
(check (parse-key "\x1b;[13;5~") => 'ctrl-enter)
(check (parse-key "\x1b;[13;3~") => 'alt-enter)
(check (parse-key "\x1b;[27;2;13~") => 'shift-enter)
(check (parse-key "\x1b;[27;5;13~") => 'ctrl-enter)
(check (parse-key "\x1b;[27;3;13~") => 'alt-enter)
(check (parse-key "\x1b;[27;2;9~") => 'shift-tab)
(check (parse-key "\x1b;[1;2A") => 'shift-up)
(check (parse-key "\x1b;[1;3A") => 'alt-up)
(check (parse-key "\x1b;[1;5A") => 'ctrl-up)
(check (parse-key "\x1b;[1;2B") => 'shift-down)
(check (parse-key "\x1b;[1;3B") => 'alt-down)
(check (parse-key "\x1b;[1;5B") => 'ctrl-down)
(check (parse-key "\x1b;[1;2C") => 'shift-right)
(check (parse-key "\x1b;[1;3C") => 'alt-right)
(check (parse-key "\x1b;[1;5C") => 'ctrl-right)
(check (parse-key "\x1b;[1;2D") => 'shift-left)
(check (parse-key "\x1b;[1;3D") => 'alt-left)
(check (parse-key "\x1b;[1;5D") => 'ctrl-left)
(check (parse-key "\x1b;[1;5H") => 'ctrl-home)
(check (parse-key "\x1b;[1;5F") => 'ctrl-end)
(check (parse-key "\x1b;[3;5~") => 'ctrl-delete)
(check (parse-key "\x1b;[5;5~") => 'ctrl-page-up)
(check (parse-key "\x1b;[6;5~") => 'ctrl-page-down)

;; kitty CSI-u / xterm modifyOtherKeys 的 ctrl/alt 组合键
;; （增强键盘协议：raw mode 启用 \x1b[>4;2m\x1b[>1u 后终端的编码形式）
(check (parse-key "\x1b;[100;5u") => 'ctrl-d)
(check (parse-key "\x1b;[99;5u") => 'ctrl-c)
(check (parse-key "\x1b;[106;5u") => 'ctrl-j)
(check (parse-key "\x1b;[111;5u") => 'ctrl-o)
(check (parse-key "\x1b;[116;5u") => 'ctrl-t)
(check (parse-key "\x1b;[97;3u") => 'alt-a)
(check (parse-key "\x1b;[97;6u") => 'shift-ctrl-a)
(check (parse-key "\x1b;[32;5u") => 'ctrl-space)
(check (parse-key "\x1b;[27;5;100~") => 'ctrl-d)
(check (parse-key "\x1b;[27;3;97~") => 'alt-a)
(check (parse-key "\x1b;[27;5;106~") => 'ctrl-j)

;; 增强协议下不合成、维持 escape 回落的基线
(check (parse-key "\x1b;[27u") => 'escape)
(check (parse-key "\x1b;[97u") => 'escape)
(check (parse-key "\x1b;[97;1u") => 'escape)
(check (parse-key "\x1b;[97;2u") => 'escape)
(check (parse-key "\x1b;[57344;5u") => 'escape)
(check (parse-key "\x1b;[97;9u") => 'escape)

;; Alt + 字符 / 键
(check (parse-key "\x1b;a") => 'alt-a)
(check (parse-key "\x1b;B") => 'alt-B)
(check (parse-key "\x1b;1") => 'alt-1)
(check (parse-key "\x1b;\r") => 'alt-enter)
(check (parse-key "\x1b;\t") => 'alt-tab)
(check (parse-key "\x1b;") => 'alt-backspace)

;; with-rest? 参数
(check (parse-key "\x1b;[Adef" #t) => (cons 'up "def"))
(check (parse-key "\r\nxyz" #t) => (cons 'enter "xyz"))
(check (parse-key "abc" #t) => (cons "a" "bc"))
(check (parse-key "你好" #t) => (cons "你" "好"))
(check (parse-key "" #t) => (cons #f ""))

;; 边界条件与错误处理
(check (parse-key "") => #f)
(check-catch 'type-error (parse-key 123))
(check-catch 'type-error (parse-key #\a))
(check-catch 'type-error (parse-key 'up))

(check-report)
